<% if (page.photos && page.photos.length) { %>
<%
  var hasCaptions = page.captions && page.captions.length === page.photos.length;
  var galleryClass = 'article-gallery' + (hasCaptions ? ' with-captions' : '');
  if (page.gallery === 'collage') galleryClass += ' gallery-collage';
  if (page.gallery === 'grid') galleryClass += ' gallery-grid';
%>
<div class="<%= galleryClass %>">
    <% page.photos.forEach(function(photo, i) { %>
      <% var cap = hasCaptions && page.captions[i] ? page.captions[i] : ''; %>
      <figure class="gallery-figure">
        <a href="<%- url_for(photo) %>" rel="gallery_<%= page._id %>" class="gallery-item"<% if (cap) { %> title="<%= cap %>"<% } %>>
          <%- responsive_image(url_for(photo), cap, { loading: i === 0 ? 'eager' : 'lazy' }) %>
        </a>
        <% if (cap) { %>
          <figcaption class="gallery-caption"><%= cap %></figcaption>
        <% } %>
      </figure>
    <% }) %>
</div>
<% } %>
