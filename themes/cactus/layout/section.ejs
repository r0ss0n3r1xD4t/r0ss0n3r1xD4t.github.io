<div id="section">
  <div class="section-header">
    <h1 class="section-title"><%= page.title %></h1>
    <% if (page.description) { %>
      <p class="section-description"><%= page.description %></p>
    <% } %>
  </div>
  <div id="archive">
    <ul class="post-list">
      <% var year = 0 %>
      <% var change = false %>
      <% var sectionPosts = site.categories.findOne({name: page.section}) %>
      <% if (sectionPosts) { %>
        <% sectionPosts.posts.sort('date', 'desc').each(function(post) { %>
          <% var itemYear = date(post.date, 'YYYY') %>
          <% change = year !== itemYear %>
          <% year = change ? itemYear : year %>
          <% if (change) { %>
            <li class="post-year"><h2><%= year %></h2></li>
          <% } %>
          <li class="post-item">
            <%- partial('_partial/post/date', { post: post, class_name: 'meta' }) %>
            <span><%- partial('_partial/post/title', { post: post, index: true, class_name: '' }) %></span>
          </li>
        <% }); %>
      <% } %>
    </ul>
  </div>
</div>
