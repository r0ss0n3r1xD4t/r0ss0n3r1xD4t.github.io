// Photo gallery with captions (used by life posts)
.article-gallery
  picture
    display: block
    width: 100%

.article-gallery.with-captions
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))
  gap: 1.25rem
  margin: 1.5rem 0

  .gallery-figure
    margin: 0
    display: flex
    flex-direction: column

    .gallery-item
      display: block
      background: none
      border-radius: 4px
      overflow: hidden
      border: 1px solid $color-border

      img
        display: block
        width: 100%
        height: auto
        margin: 0
        aspect-ratio: 4 / 3
        object-fit: cover
        transition: opacity 0.2s ease

        &:hover
          opacity: 0.88

      picture
        height: auto

    .gallery-caption
      margin: 0.4rem 0 0
      color: $color-meta-code
      font-size: 0.85rem
      line-height: 1.45
      text-align: center
      hyphens: auto

@media (max-width: 480px)
  .article-gallery.with-captions
    grid-template-columns: 1fr
    gap: 1rem

// Collage layout for life photo dumps:
// one large image, two stacked images, then a full-width image.
.article-gallery.gallery-collage
  display: grid
  grid-template-columns: 2fr 1fr
  grid-template-rows: repeat(2, minmax(10rem, 1fr)) auto
  gap: 0.35rem
  margin: 1.5rem 0

  .gallery-figure
    min-width: 0
    margin: 0

    .gallery-item,
    img
      display: block
      width: 100%
      height: 100%
      margin: 0

    .gallery-item
      background: none
      overflow: hidden

    picture
      height: 100%

    img
      object-fit: cover

    .gallery-caption
      display: none

  .gallery-figure:nth-child(1)
    grid-row: 1 / span 2

  .gallery-figure:nth-child(4)
    grid-column: 1 / -1
    aspect-ratio: 3 / 2

@media (max-width: 700px)
  .article-gallery.gallery-collage
    display: grid
    grid-template-columns: 1fr
    grid-template-rows: none
    gap: 0.75rem

    .gallery-figure:nth-child(1),
    .gallery-figure:nth-child(4)
      grid-column: auto
      grid-row: auto

    .gallery-figure,
    .gallery-figure:nth-child(4)
      aspect-ratio: 4 / 3

      img
        height: 100%

.article-gallery.gallery-grid
  display: grid
  grid-template-columns: repeat(3, minmax(0, 1fr))
  gap: 0.35rem
  margin: 1.5rem 0

  .gallery-figure
    min-width: 0
    margin: 0
    aspect-ratio: 1 / 1

    .gallery-item
      display: block
      width: 100%
      height: 100%
      margin: 0

    .gallery-item
      background: none
      overflow: hidden

    picture
      height: 100%

    img
      display: block
      width: 100%
      height: 100%
      aspect-ratio: 1 / 1
      object-fit: cover

    .gallery-caption
      display: none

@media (max-width: 700px)
  .article-gallery.gallery-grid
    grid-template-columns: 1fr
    gap: 0.75rem

// Inline two-image rows for photo essays.
.image-row
  display: grid
  grid-template-columns: repeat(2, minmax(0, 1fr))
  gap: 0.75rem
  margin: 1.25rem 0

  img
    display: block
    width: 100%
    height: auto
    margin: 0

.image-row--three
  grid-template-columns: repeat(3, minmax(0, 1fr))

.image-row--four
  grid-template-columns: repeat(4, minmax(0, 1fr))

@media (max-width: 700px)
  .image-row,
  .image-row--three
    grid-template-columns: 1fr

  .image-row--four
    grid-template-columns: repeat(2, minmax(0, 1fr))

.image-lightbox[hidden]
  display: none

.image-lightbox
  position: fixed
  inset: 0
  z-index: 100
  display: grid
  place-items: center
  padding: 2rem
  background: rgba(0, 0, 0, 0.88)
  cursor: zoom-out

  &__image
    max-width: 95vw
    max-height: 90vh
    width: auto
    height: auto
    object-fit: contain
    cursor: default

  &__close
    position: fixed
    top: 1rem
    right: 1rem
    z-index: 1
    width: 2.5rem
    height: 2.5rem
    border: 1px solid #fff
    background: transparent
    color: #fff
    font-size: 1.75rem
    line-height: 1
    cursor: pointer

.image-lightbox-open
  overflow: hidden
