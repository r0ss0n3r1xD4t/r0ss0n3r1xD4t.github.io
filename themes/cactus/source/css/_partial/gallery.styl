// Photo gallery with captions (used by life posts)
.article-gallery.with-captions
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))
  gap: 1.25rem
  margin: 1.5rem 0

  .gallery-figure
    margin: 0
    display: flex
    flex-direction: column

    .gallery-item
      display: block
      background: none
      border-radius: 4px
      overflow: hidden
      border: 1px solid $color-border

      img
        display: block
        width: 100%
        height: auto
        margin: 0
        aspect-ratio: 4 / 3
        object-fit: cover
        transition: opacity 0.2s ease

        &:hover
          opacity: 0.88

    .gallery-caption
      margin: 0.4rem 0 0
      color: $color-meta-code
      font-size: 0.85rem
      line-height: 1.45
      text-align: center
      hyphens: auto

@media (max-width: 480px)
  .article-gallery.with-captions
    grid-template-columns: 1fr
    gap: 1rem
